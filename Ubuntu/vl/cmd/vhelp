#!/bin/bash

case $1 in
    --git)
    echo "List uncommitted files:"
    echo "    git status"
    echo "Stage:"
    echo "    git add ."
    echo "Unstage:"
    echo "    git restore --staged ."
    echo "Commit:"
    echo "    git commit -a -m \"message\""
    echo "Uncommit last commit:"
    echo "    git reset HEAD~1"
    echo "Delete unstaged files:"
    echo "    git checkout -- ."
    echo "Delete everything:"
    echo "    git clean -fxd"
    echo "Create branch:"
    echo "    LOCAL:  git checkout -b BRANCH [origin/BRANCH]"
    echo "    REMOTE: git push [-u] origin BRANCH"
    echo "Delete branch:"
    echo "    LOCAL:  git branch -d BRANCH"
    echo "    REMOTE: git push origin --delete BRANCH"
    echo "List all branches:"
    echo "    LOCAL:  git branch -a"
    echo "    REMOTE: git branch -r"
    echo "Switch branch:"
    echo "    git checkout BRANCH"
    echo "Merge branch to current branch:"
    echo "    git merge BRANCH"
    echo "Pull all remote branches:"
    echo "    git pull --all"
    echo "Rebase with remote branch:"
    echo "    git fetch"
    echo "    git rebase origin/BRANCH"
    echo "    git push origin BRANCH"
    ;;

    *)
    echo "vhelp"
    echo "    Help information for Vczh Libraries Control Panel."
    echo "    --git"
    echo "        Quick help for git"
    echo "vgo --help"
    echo "    Quick way to jump to a predefined folder."
    echo "vt4 --help"
    echo "    T4 template processor."
    echo "vmake --help"
    echo "    Generate makefile."
    echo "vbuild --help"
    echo "    Build the program."
    echo "vgit"
    echo "    Build GitTui and launch it in the current folder."
    echo "vssh --help"
    echo "    Quick way to setup ssh key for your github account."
    echo "vapt --help"
    echo "    Download necessary softwares."
    echo "vsync --help"
    echo "    Enlist all repos from github."
    ;;
esac
